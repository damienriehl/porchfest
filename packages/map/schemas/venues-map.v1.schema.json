{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "venues-map.v1.schema.json",
  "title": "SAP Porchfest 2026 venues map",
  "description": "Canonical public map-data contract for the 2026 SAP Porchfest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "season",
    "generated_from",
    "event",
    "venues"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$"
    },
    "season": {
      "type": "integer",
      "minimum": 2000
    },
    "generated_from": {
      "enum": ["porchfest/tools/render.py", "packages/web/src/routes/map.ts"]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "time",
        "city",
        "state"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "time": {
          "type": "string",
          "minLength": 1
        },
        "city": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "venues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/venue"
      }
    }
  },
  "$defs": {
    "venue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "address",
        "lat",
        "lng",
        "schedule",
        "acts"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "address": {
          "type": "string",
          "minLength": 1
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "schedule": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(.*\\S)?$"
        },
        "acts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/act"
          }
        }
      }
    },
    "act": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot",
        "slot_label",
        "name",
        "genre",
        "description",
        "links"
      ],
      "properties": {
        "slot": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(.*\\S)?$"
        },
        "slot_label": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(.*\\S)?$"
        },
        "slot_start": {
          "type": "string",
          "format": "time"
        },
        "slot_end": {
          "type": "string",
          "format": "time"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "genre": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https?://"
        }
      }
    }
  }
}
