# Copy to .env only when you need to override the zero-configuration defaults.
# PUBLIC_BASE_URL becomes required when an email provider or magic links are enabled.
PUBLIC_BASE_URL=https://porchfest.example

# Never deploy this literal value. Leave the variable unset to generate a unique
# key in the named data volume on first boot.
PORCHFEST_SESSION_SECRET=replace-with-a-unique-random-secret

# Number of trusted reverse-proxy hops in front of the app. The reference Compose
# topology puts exactly one (Caddy) there and sets this to 1. Leave it UNSET for a
# direct deployment: X-Forwarded-For is ignored entirely unless this is set, which
# is what stops a spoofed header from resetting a per-IP cap.
PORCHFEST_TRUSTED_PROXY_HOPS=

# Participant contact data is anonymized after this many calendar months. Leave
# unset (or set an invalid value) for the safe 24-month default.
PORCHFEST_RETENTION_MONTHS=24

# Cloudflare Turnstile. Set BOTH or NEITHER — one alone is a startup error, because
# the site key mounts the widget and the secret key verifies it. With neither set the
# deployment still gets per-IP rate limiting and a honeypot.
PORCHFEST_TURNSTILE_SITE_KEY=
PORCHFEST_TURNSTILE_SECRET_KEY=
