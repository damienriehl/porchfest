# Copy to .env only when you need to override the zero-configuration defaults.
# PUBLIC_BASE_URL becomes required when an email provider or magic links are enabled.
PUBLIC_BASE_URL=https://porchfest.example

# Never deploy this literal value. Leave the variable unset to generate a unique
# key in the named data volume on first boot.
PORCHFEST_SESSION_SECRET=replace-with-a-unique-random-secret
