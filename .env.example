# Copy to .env only when you need to override the zero-configuration defaults.
# PUBLIC_BASE_URL becomes required when an email provider or magic links are enabled.
PUBLIC_BASE_URL=https://porchfest.example

# Never deploy this literal value. Leave the variable unset to generate a unique
# key in the named data volume on first boot.
PORCHFEST_SESSION_SECRET=replace-with-a-unique-random-secret

# Number of trusted reverse-proxy hops in front of the app. The reference Compose
# topology puts exactly one (Caddy) there and sets this to 1. Leave it UNSET for a
# direct deployment: X-Forwarded-For is ignored entirely unless this is set, which
# is what stops a spoofed header from resetting a per-IP cap.
PORCHFEST_TRUSTED_PROXY_HOPS=

# Participant contact data is anonymized after this many calendar months. Leave
# unset (or set an invalid value) for the safe 24-month default.
PORCHFEST_RETENTION_MONTHS=24

# Cloudflare Turnstile. Set BOTH or NEITHER — one alone is a startup error, because
# the site key mounts the widget and the secret key verifies it. With neither set the
# deployment still gets per-IP rate limiting and a honeypot.
PORCHFEST_TURNSTILE_SITE_KEY=
PORCHFEST_TURNSTILE_SECRET_KEY=

# Venue geocoding. GEO_PROVIDER defaults to null. Set it to osm only with a
# deployment-specific GEO_USER_AGENT; do not copy a real contact identifier into
# this example file. Country codes use Nominatim's comma-separated format. Empty
# timeout values use the @porchfest/geo defaults.
GEO_PROVIDER=null
GEO_USER_AGENT=
GEO_COUNTRY_CODES=us
GEO_OVERPASS_TIMEOUT_MS=
GEO_NOMINATIM_TIMEOUT_MS=

# SMTP sending. Set HOST and FROM together to enable the outbox's send button;
# leave every SMTP variable unset and the outbox offers copy-paste and export
# instead. Half a configuration is a startup error, not a silent downgrade.
# USERNAME needs PASSWORD or PASSWORD_FILE; PASSWORD_FILE (a 0600 mount or a
# Docker secret) is read once at boot and wins over PASSWORD. SECURE=true means
# implicit TLS from the first byte (port 465); STARTTLS=true upgrades after EHLO
# on 587 and refuses a server that does not offer it.
PORCHFEST_SMTP_HOST=
PORCHFEST_SMTP_FROM=
PORCHFEST_SMTP_PORT=
PORCHFEST_SMTP_SECURE=false
PORCHFEST_SMTP_STARTTLS=true
PORCHFEST_SMTP_USERNAME=
PORCHFEST_SMTP_PASSWORD=
PORCHFEST_SMTP_PASSWORD_FILE=

# Deployment identity. Every instance gets literal, stable names; do not use the
# reference defaults on a real host. COMPOSE_FILE selects the bring-your-own-
# Traefik topology. Remove its second path to use the reference Caddy service.
COMPOSE_FILE=compose.yaml:deploy/compose.external-proxy.yaml
PORCHFEST_COMPOSE_PROJECT=porchfest-neighborhood
PORCHFEST_APP_IMAGE=porchfest-neighborhood:current
PORCHFEST_DATA_VOLUME=porchfest-neighborhood-data
PORCHFEST_CADDY_DATA_VOLUME=porchfest-neighborhood-caddy-data
PORCHFEST_CADDY_CONFIG_VOLUME=porchfest-neighborhood-caddy-config

# Existing Traefik v3 edge. The app publishes no host port in this topology.
PORCHFEST_DOMAIN=porchfest.example
PORCHFEST_PROXY_NETWORK=proxy-network
PORCHFEST_TLS_RESOLVER=letsencrypt

# Local quiesced archives. Keep this outside the checkout and any served path.
PORCHFEST_ARCHIVE_DIR=/var/backups/porchfest-neighborhood
PORCHFEST_ARCHIVE_KEEP=7
PORCHFEST_UTILITY_IMAGE=alpine:3.22

# Encrypted off-host backup. The age recipient is public; the matching private
# identity belongs on the separate restore machine, never this deployment box.
PORCHFEST_DEPLOY_OFFSITE=1
PORCHFEST_BACKUP_AGE_RECIPIENT=age1replace-with-a-real-public-recipient
PORCHFEST_BACKUP_REMOTE=remote-name:porchfest-neighborhood
PORCHFEST_BACKUP_KEEP=30

# Source-to-host shipment. Use an SSH alias or placeholder hostname, never a real
# host/IP in the repository. The on-box .env is excluded from rsync deletion.
PORCHFEST_DEPLOY_HOST=deploy-host.example
PORCHFEST_DEPLOY_DIR=/srv/porchfest-neighborhood
PORCHFEST_EXTERNAL_CONNECT_TIMEOUT=5
PORCHFEST_EXTERNAL_MAX_TIME=20

# Optional when more than one active organizer exists. The deploy cookie probe
# issues and immediately revokes a short-lived login for this organizer.
PORCHFEST_DEPLOY_ORGANIZER_SELECTOR=organizer@porchfest.example
